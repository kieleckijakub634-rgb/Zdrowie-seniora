{
  "name": "zdrowie-seniora",
  "version": "1.0.0",
  "description": "VitalFly - aplikacja webowa i mobilna wspierająca zdrowy styl życia seniorów.",
  "scripts": {
    "start": "node tools/serve.mjs",
    "build:css": "tailwindcss -c tailwind.config.cjs -i assets/tailwind.input.css -o www/assets/css/tailwind.css --minify",
    "build:headers": "node tools/generate-headers.mjs",
    "build": "npm run build:css && npm run build:headers",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "npm run android:sync && android\\gradlew.bat -p android assembleDebug",
    "check": "node tools/check.mjs",
    "test": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kieleckijakub634-rgb/Zdrowie-seniora.git"
  },
  "keywords": [
    "seniorzy",
    "zdrowie",
    "ćwiczenia",
    "dieta",
    "capacitor"
  ],
  "author": "VitalFly",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/kieleckijakub634-rgb/Zdrowie-seniora/issues"
  },
  "homepage": "https://vitalfly.pl/",
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "tailwindcss": "^3.4.17"
  }
}
